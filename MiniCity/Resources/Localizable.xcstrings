    "時間を進める。人が入れば商業の需要が立ち上がる": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Zeit laufen. Sobald Leute einziehen, entsteht Nachfrage nach Gewerbe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let time run. Once people move in, commercial demand picks up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja correr el tiempo. Cuando llegue gente, aparecerá demanda comercial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le temps passer. Une fois les habitants installés, la demande commerciale apparaît"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 진행합니다. 사람이 들어오면 상업 수요가 생깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o tempo correr. Quando as pessoas chegarem, surge demanda comercial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让时间流动。有人入住后，商业需求就会出现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓時間流動。有人入住後，商業需求就會出現"
          }
        }
      }
    },
