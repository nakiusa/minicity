        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 도구로 칸을 칠합니다. \"이동\" 도구면 지도가 움직입니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
