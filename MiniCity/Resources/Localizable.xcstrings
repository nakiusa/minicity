          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存当前城市的副本。正在玩的城市照常继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
