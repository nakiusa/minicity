    "区画は道路に面していないと育たない。住民は道路で職場に通う。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen wachsen nicht ohne Straße daneben. Einwohner pendeln über Straßen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones won't grow without a road next to them. Residents commute along roads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas no crecen sin una calle al lado. Los habitantes van al trabajo por las calles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones ne poussent pas sans route à côté. Les habitants vont travailler par les routes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구역은 도로에 닿지 않으면 자라지 않습니다. 주민은 도로로 출근합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas não crescem sem uma rua ao lado. Moradores vão ao trabalho pelas ruas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域不靠路就不会生长。居民沿道路通勤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域不靠路就不會生長。居民沿道路通勤。"
          }
        }
      }
    },
