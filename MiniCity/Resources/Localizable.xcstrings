    "水辺と森と公園で上がり、街の中心とにぎわいで上がり、公害と犯罪と渋滞で下がります。住宅はこれに強く反応します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steigt durch Wasser, Wald und Parks, durch Zentrum und Betrieb. Sinkt durch Verschmutzung, Kriminalität und Verkehr. Häuser reagieren stark darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises with water, forest and parks, with the city center and activity. Falls with pollution, crime and traffic. Homes react strongly to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube con agua, bosque y parques, con el centro y la actividad. Baja con contaminación, crimen y tráfico. Las casas reaccionan mucho a esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte avec l'eau, la forêt et les parcs, avec le centre-ville et l'activité. Baisse avec pollution, criminalité et trafic. Les maisons y sont très sensibles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물가, 숲, 공원으로 오르고, 도심과 활기로 오르며, 공해, 범죄, 체증으로 떨어집니다. 주택은 이에 강하게 반응합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe com água, floresta e parques, com o centro e a atividade. Cai com poluição, crime e trânsito. Casas reagem muito a isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠水、森林和公园会升，靠市中心和活力会升；污染、犯罪、拥堵会降。住宅对它反应强烈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靠水、森林和公園會升，靠市中心和活力會升；污染、犯罪、壅塞會降。住宅對它反應強烈。"
          }
        }
      }
    },
