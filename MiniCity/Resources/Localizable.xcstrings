    },
    "1本指でマスを塗る（道路や送電線はなぞれる）": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Finger malt Felder (Straßen und Stromleitungen lassen sich ziehen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One finger paints tiles (roads and power lines can be dragged)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dedo pinta casillas (carreteras y tendido eléctrico se pueden arrastrar)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doigt peint les cases (routes et lignes électriques se tracent en glissant)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 칸을 칠합니다(도로와 송전선은 드래그로 그을 수 있음)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dedo pinta quadros (ruas e linhas de energia podem ser arrastadas)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指涂抹格子（道路和输电线可以拖画）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指塗抹格子（道路和輸電線可以拖曳）"
          }
        }
      }
    },
