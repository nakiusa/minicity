    "人が住む。土地の値打ちに敏感で、公害と犯罪を嫌う。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo Menschen wohnen. Reagiert auf den Bodenwert; mag keine Verschmutzung und Kriminalität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where people live. Sensitive to land value; dislikes pollution and crime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde vive la gente. Sensible al valor del suelo; rechaza contaminación y crimen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vivent les gens. Sensible à la valeur foncière ; fuit pollution et criminalité."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람이 사는 곳. 지가에 민감하고 공해와 범죄를 싫어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde as pessoas moram. Sensível ao valor do terreno; não gosta de poluição e crime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人们居住的地方。对地价敏感，讨厌污染和犯罪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人們居住的地方。對地價敏感，討厭污染和犯罪。"
          }
        }
      }
    },
    "人が増えると増える。警察署で減る": {
      "localizations": {
