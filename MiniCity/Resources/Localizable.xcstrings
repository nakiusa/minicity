    "高すぎる。人も企業も出ていく": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu hoch. Leute und Firmen ziehen weg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too high. People and businesses leave"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado altos. Se van la gente y las empresas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop élevés. Habitants et entreprises s'en vont"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 높습니다. 사람도 기업도 떠납니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alto demais. Pessoas e empresas vão embora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太高了。居民和企业都会离开"
          }
        },
        "zh-Hant": {
