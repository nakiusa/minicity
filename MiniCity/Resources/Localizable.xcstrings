    "税率7％が目安。足りなければ予算から借りられる": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 % Steuern sind ein guter Richtwert. Knapp? Im Budget leihen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7% tax is a good baseline. Short on cash? Borrow in Budget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 7% de impuestos es la referencia. Si falta, pide un préstamo en Presupuesto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 % d'impôts est un bon repère. À court ? Empruntez dans Budget"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세율 7%가 기준. 부족하면 예산에서 빌릴 수 있습니다"
          }
        },
        "pt-BR": {
